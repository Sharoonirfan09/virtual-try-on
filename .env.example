# true (default) = simulated generation, no AI provider required.
# false = real AI try-on through /api/try-on (Vercel AI Gateway).
NEXT_PUBLIC_DEMO_MODE=true

# Server-only. On Vercel, AI Gateway authenticates automatically (OIDC).
# Locally, `vercel link` + `vercel env pull` provides VERCEL_OIDC_TOKEN,
# or set an AI Gateway API key instead. Never prefix these with NEXT_PUBLIC_.
AI_GATEWAY_API_KEY=
# Optional model override (an id from https://ai-gateway.vercel.sh/v1/models)
AI_GATEWAY_TRYON_MODEL=google/gemini-3.1-flash-image
